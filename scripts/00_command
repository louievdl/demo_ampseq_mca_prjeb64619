# 20260420 rerun an old study to demo the ampseq pipeline - note, HPC paths and identifying data were later obscured before postig script on github
# downloaded fastq files to ../data_orig and renamed them extensively into ../data as follows
for i in ../data_orig/*.fastq.gz;
  do echo $i;
  j=$(echo $i | perl -ne 'chomp; $in = $_; s/\/data_orig\//\/data\//; s/\/807-/\//; s/-p..._S\d+_L001_/_/; s/_001.fastq/.fastq/; print "cp -a $in $_"; `cp -a $in $_`');
  echo $j;
done | less

# create metadata
python3 ~/cgebm/cgebm_pipelines/fastq_dir_to_samplesheet.py -st reverse -r1 _R1.fastq.gz -r2 _R2.fastq.gz ../data metadata.csv
# added metadata in windows

# set analysis config; set Group (Control/Alzheimers/AlzCB) as main variable, no var2. Could make Home as var2, but one home has only one individual, and really, individual Volunteer is probably most correct
vi analysis.sh

# run analysis
~/cgebm/cgebm_pipelines_test/mca_ppln.sh analysis.sh 
